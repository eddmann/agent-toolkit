{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "coverage", "limitations"],
  "properties": {
    "verdict": {"type": "string", "enum": ["NO_BLOCKERS", "CHANGES_REQUIRED", "INCOMPLETE"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "path", "line", "evidence", "trigger", "impact", "fix"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["blocker", "optional"]},
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "evidence": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "fix": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
